{
	"name": "ramitos-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"preinstall": "node scripts/check-package-manager.mjs",
		"dev": "vite",
		"build": "tsc -b && vite build",
		"generate:api": "orval --config orval.config.ts",
		"preview": "vite preview",
		"test": "vitest",
		"format": "prettier . --write",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"format:check": "prettier . --check",
		"test:run": "vitest run",
		"test:e2e": "playwright test",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build",
		"api:update": "node scripts/update-api-schemas.mjs"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.0.0",
		"@mui/material": "^9.0.0",
		"@tanstack/react-query": "^5.99.0",
		"@tanstack/react-router": "^1.168.18",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-markdown": "^10.1.0",
		"recharts": "^3.8.1",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@faker-js/faker": "^10.4.0",
		"@playwright/test": "^1.62.1",
		"@tanstack/react-query-devtools": "^5.99.0",
		"@tanstack/router-devtools": "^1.166.13",
		"@tanstack/router-plugin": "^1.167.18",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.8.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"jsdom": "^29.0.2",
		"msw": "^2.14.6",
		"orval": "^8.10.0",
		"prettier": "^3.8.3",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.0.8",
		"vitest": "^4.1.4"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	},
	"packageManager": "pnpm@11.1.2",
	"engines": {
		"node": ">=24.0.2 <25"
	}
}
